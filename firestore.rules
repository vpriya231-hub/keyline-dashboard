rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Blanket user listing is forbidden
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.credits is number
                    && request.resource.data.credits >= 0;
      allow update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.credits is number;
      allow delete: if isOwner(userId);

      // API Keys subcollection
      match /api_keys/{keyId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isValidId(keyId)
                      && request.resource.data.userId == userId
                      && request.resource.data.key is string
                      && request.resource.data.key.size() <= 128
                      && request.resource.data.status in ['active', 'revoked'];
        allow update: if isOwner(userId)
                      && request.resource.data.userId == userId
                      && request.resource.data.key == resource.data.key
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'name', 'updatedAt', 'revokedAt']);
        allow delete: if isOwner(userId);
      }

      // Usage logs subcollection
      match /usage_logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isValidId(logId)
                      && request.resource.data.userId == userId
                      && request.resource.data.tokensUsed is number
                      && request.resource.data.tokensUsed >= 0;
        allow update: if false; // Usage logs are immutable during regular audits
        allow delete: if isOwner(userId); // Allowed during account deletion cleanup
      }

      // Transactions subcollection (Razorpay Checkout logs)
      match /transactions/{txId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                      && request.resource.data.paymentId is string
                      && request.resource.data.amount is number
                      && request.resource.data.credits is number
                      && request.resource.data.status in ['completed', 'failed', 'pending'];
        allow update: if false; // Immutable payment ledger
        allow delete: if isOwner(userId); // Allowed during account deletion cleanup
      }
    }

    // Top-level API Keys (for high-speed gateway routing & lookup)
    match /api_keys/{key} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status in ['active', 'revoked'];
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.uid == request.auth.uid;
    }

    // Top-up Requests collection (for dynamic UPI top-up verification)
    match /topup_requests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.amount is number
                    && request.resource.data.amount > 0
                    && request.resource.data.credits is number
                    && request.resource.data.credits > 0
                    && request.resource.data.utrNumber is string
                    && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // Payment Requests collection (legacy compatibility for UPI top-up verification)
    match /payment_requests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Claimed Trials collection (Permanent lifetime tracking of free tier claim per email)
    match /claimed_trials/{email} {
      // Any authenticated user can check if their email has already claimed the free tier
      allow get: if isSignedIn();
      allow list: if false; // Blanket listing forbidden
      // Can only create if signed in and the record matches their authenticated uid
      allow create: if isSignedIn()
                    && request.resource.data.initialUid == request.auth.uid;
      // Strictly immutable: permanent lifetime record that cannot be deleted or reset even upon account deletion
      allow update, delete: if false;
    }
  }
}
