rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Blanket user listing is forbidden
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.credits is number
                    && request.resource.data.credits >= 0;
      allow update: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.credits is number;
      allow delete: if isOwner(userId);

      // API Keys subcollection
      match /api_keys/{keyId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isValidId(keyId)
                      && request.resource.data.userId == userId
                      && request.resource.data.key is string
                      && request.resource.data.key.size() <= 128
                      && request.resource.data.status in ['active', 'revoked'];
        allow update: if isOwner(userId)
                      && request.resource.data.userId == userId
                      && request.resource.data.key == resource.data.key
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'name', 'updatedAt', 'revokedAt']);
        allow delete: if isOwner(userId);
      }

      // Usage logs subcollection
      match /usage_logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isValidId(logId)
                      && request.resource.data.userId == userId
                      && request.resource.data.tokensUsed is number
                      && request.resource.data.tokensUsed >= 0;
        allow update: if false; // Usage logs are immutable during regular audits
        allow delete: if isOwner(userId); // Allowed during account deletion cleanup
      }
    }

    // Top-level API Keys (for high-speed gateway routing & lookup)
    match /api_keys/{key} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status in ['active', 'revoked'];
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.uid == request.auth.uid;
    }

    // Payment Requests collection (for UPI top-up verification)
    match /payment_requests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.packageAmount is number
                    && request.resource.data.packageAmount > 0
                    && request.resource.data.creditsToAdd is number
                    && request.resource.data.creditsToAdd > 0
                    && request.resource.data.utrNumber is string
                    && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }
  }
}
